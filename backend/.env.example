# SmartClinic server
PORT=5180
CORS_ORIGIN=http://localhost:5180

# Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
# Named instance (e.g. SQLEXPRESS) – leave empty to use DB_PORT
DB_INSTANCE=
DB_USER=sa
DB_PASSWORD=
DB_NAME=T_multi_branch
# Encrypted connection; trust the server's own certificate (typical for self-hosted SQL Server)
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Clinic local time (India = 330 minutes ahead of UTC)
APP_TZ=Asia/Kolkata
TZ_OFFSET_MINUTES=330

# First Super Admin created by the setup step
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Super Admin
# 1 = also create demo data: multi-branch → Clinic A (CLA) + Clinic B (CLB) and cla.* staff;
#     single-clinic → only the staff of CLINIC_CODE (e.g. dc.reception, dc.doctor, dc.pharmacy, dc.billing)
SEED_DEMO=1

# 1 = single clinic: no branches, no clinic switcher. 0 or empty = multi-branch (current behaviour)
# The database must be new or hold only one clinic.
SINGLE_CLINIC=0
CLINIC_CODE=SC
CLINIC_NAME=Saravana Clinic
